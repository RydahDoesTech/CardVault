# Copy to `.env` in the project root. Expo loads EXPO_PUBLIC_* at build time.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional — Pokémon TCG API key from https://dev.pokemontcg.io/ (higher rate limits)
# EXPO_PUBLIC_POKEMON_TCG_API_KEY=

# Force mock implementations (no network)
# EXPO_PUBLIC_USE_MOCK_CARD_SEARCH=true
# EXPO_PUBLIC_USE_MOCK_PRICING=true
